# Copy to .env and fill in. .env is gitignored — never commit it.

# Anthropic API key for the hosted agent (maker-agent) and live evals.
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Optional overrides (defaults shown):
# MAKERLORD_FRITZING_PATH=./vendor/fritzing-parts
# MAKERLORD_PROFILES_PATH=./data/profiles
# MAKERLORD_CURATED_PATH=./data/curated.json
# MAKERLORD_BOARD_GRID_PATH=./data/boards/half-breadboard.json
# MAKERLORD_SPICE_PATH=./data/spice

# Agent backend: 'sdk' (default, needs ANTHROPIC_API_KEY) or 'acp' — spawn an
# ACP agent (e.g. Claude Code via claude-code-acp) that drives the project
# through maker-mcp; the maker's subscription pays instead of the API key.
#MAKERLORD_AGENT_BACKEND=acp
#MAKERLORD_ACP_COMMAND=claude-code-acp
#MAKERLORD_MCP_PATH=./packages/mcp/dist/main.js
